{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "chronosphere-desktop",
  "version": "0.1.0",
  "identifier": "com.chronosphere.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Chrono Sphere",
        "width": 400,
        "height": 700,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdFNDgzQzdFRkMzNkU2ODkKUldTSjVqYjhmanhJZmpOVk8yRkIrSWZEYU0rY1ZKdFU0S0hGakpSd0doaGJKTUFuSlgxaCthS1IK",
      "endpoints": [
        "https://github.com/PrettySailorSoldier/chronosphere-desktop/releases/latest/download/latest.json"
      ],
      "dialog": true
    }
  }
}